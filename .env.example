# ------------------------------------------------------------------
# FastAPI Boilerplate - environment configuration
# Copy this file to `.env` and adjust the values.
# ------------------------------------------------------------------

# Application
APP_NAME="FastAPI Boilerplate"
APP_VERSION="0.1.0"
# true for local dev only (allows a weak SECRET_KEY, shows tracebacks).
DEBUG=true
LOG_LEVEL=INFO

# Database
# SQLite (dev default):
DATABASE_URL=sqlite+aiosqlite:///./app.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
#
# Dev convenience: create tables automatically on startup.
# Leave `false` in production and use `alembic upgrade head` instead.
AUTO_CREATE_TABLES=true

# Security - at least 32 characters, e.g. `openssl rand -hex 32`.
# The app refuses to start with a shorter key unless DEBUG=true.
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - a JSON list of allowed origins, e.g. ["https://app.example.com"]
CORS_ORIGINS=["*"]

# Rate limiting (Redis-backed, fixed window, per client IP)
# Leave REDIS_URL empty to disable rate limiting entirely.
REDIS_URL=
RATE_LIMIT_ENABLED=true
# Global limit: max requests per IP per window on any v1 endpoint except health.
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_WINDOW_SECONDS=60
# Stricter extra budget for /auth/register and /auth/login (per IP per minute).
RATE_LIMIT_AUTH_PER_MINUTE=10
# Behind a reverse proxy: uvicorn reads this to trust X-Forwarded-For from the
# proxy, so limits apply per real client IP (otherwise all clients share one).
# FORWARDED_ALLOW_IPS=10.0.0.0/8

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
