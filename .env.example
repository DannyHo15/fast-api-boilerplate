# ------------------------------------------------------------------
# FastAPI Boilerplate - environment configuration
# Copy this file to `.env` and adjust the values.
# ------------------------------------------------------------------

# Application
APP_NAME="FastAPI Boilerplate"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/v1

# Database
# SQLite (dev default):
DATABASE_URL=sqlite+aiosqlite:///./app.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
#
# Dev convenience: create tables automatically on startup.
# Leave `false` in production and use `alembic upgrade head` instead.
AUTO_CREATE_TABLES=true

# Security - use a long random string in production, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed origins
CORS_ORIGINS=["*"]

# Rate limiting (Redis-backed, fixed window, per client IP)
# Leave REDIS_URL empty to disable rate limiting entirely.
REDIS_URL=
RATE_LIMIT_ENABLED=true
# Global limit: max requests per IP per window on any v1 endpoint
# (auth endpoints have an additional stricter 10/minute "auth" budget).
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_WINDOW_SECONDS=60

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
